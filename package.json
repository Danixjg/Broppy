{
  "name": "internal-brain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm rust:build && ALLOW_DEMO_AUTH=true tsx apps/api/src/server.ts",
    "dev:sso": "pnpm rust:build && tsx --env-file=.env.local apps/api/src/server.ts",
    "rust:build": "node scripts/build-rust.mjs",
    "rust:test": "cargo test --locked --workspace",
    "rust:check": "cargo fmt -p brain-core --check && cargo clippy --locked --workspace --all-targets --features node -- -D warnings",
    "rust:smoke": "pnpm rust:build && tsx scripts/smoke-rust.ts",
    "dataset": "pnpm rust:build && tsx data/generate.ts",
    "theme:heroui": "node tools/heroui-theme.mjs",
    "bench": "pnpm rust:build && tsx --expose-gc apps/api/src/bench.ts",
    "doctor:sso": "pnpm rust:build && tsx --env-file=.env.local apps/api/src/doctor.ts",
    "llm:usage": "pnpm rust:build && tsx --env-file=.env.local apps/api/src/llm-usage.ts",
    "llm:check": "pnpm rust:build && tsx --env-file=.env.local apps/api/src/llm-check.ts",
    "llm:calibrate": "pnpm rust:build && tsx --env-file=.env.local apps/api/src/llm-calibrate.ts",
    "scenarios": "pnpm rust:build && vitest run apps/api/src/worked-examples.test.ts --update",
    "scenarios:model": "pnpm rust:build && WORKED_EXAMPLES=model node --env-file=.env.local node_modules/vitest/vitest.mjs run apps/api/src/worked-examples.test.ts",
    "test": "pnpm rust:build && pnpm rust:test && vitest run --pool=forks && node --test apps/web/*.nodecheck.js",
    "typecheck": "tsc --noEmit && pnpm --filter @brain/web typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
