# Copy to .env.local at the repository root and fill in the blanks.
# Both processes read .env.local: the web host (pnpm --dir apps/web dev) and the API (pnpm dev:sso).
# Keep comments on their own lines and values unquoted: Next.js and Node's --env-file both parse this file.

# ---- Shared by the web host and the API (values must match) ----
# Identifier of the Auth0 API (Applications > APIs), e.g. https://api.internal-brain
AUTH0_AUDIENCE=
# Company A's Auth0 organization ID (starts with org_), not its display name
AUTH0_ORG_ID=

# ---- Web host (Next.js) ----
APP_BASE_URL=http://127.0.0.1:3001
AUTH0_DOMAIN=dev-3es7focax4cjcswg.us.auth0.com
AUTH0_CLIENT_ID=msyBcV9l7aWnFYDW2NqlF2BvjeeUHwlD
AUTH0_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32
AUTH0_SECRET=
BRAIN_API_URL=http://127.0.0.1:3000
# Optional public demo with fictional data: the demo API's origin, e.g. http://127.0.0.1:3002 next to
# PORT=3002 pnpm dev. Leave it empty to offer SSO only.
DEMO_API_URL=

# ---- API server (pnpm dev:sso) ----
# https://AUTH0_DOMAIN/ including the trailing slash
AUTH0_ISSUER=https://dev-3es7focax4cjcswg.us.auth0.com/
# Admin-managed access: a machine-to-machine application for the Auth0 Management API, so the People page can invite
# and remove people. All three or none; AUTH0_CLIENT_ID here is the web application's. See docs/admin-managed-access.md.
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=
# Supabase project origin and server-only secret key (user directory, audit and state)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Ed25519 private key path, relative to the repository root. Generate locally:
# openssl genpkey -algorithm ed25519 -out audit-signing-key.pem
AUDIT_SIGNING_KEY_FILE=

# ---- Optional language model and semantic search (API) ----
# Without these, the built-in writer answers and search uses keywords. See the README's "Language model".
# groq (D55). The client also has tokenhub and hunyuan presets for Tencent's services; they aren't used.
LLM_PROVIDER=
LLM_API_KEY=
# openai/gpt-oss-120b on Groq
LLM_MODEL=
# Tokens per answer (default 1500). Reasoning models such as gpt-oss think before they answer; give them 4000.
LLM_MAX_TOKENS=
# Counts tokens and answers across restarts; git ignores llm-usage.json.
LLM_USAGE_FILE=llm-usage.json
# A total token budget. Optional for Groq, whose free plan can't bill; the Tencent presets require it.
LLM_TOKEN_BUDGET=
# Model answers per UTC day; after that, the built-in writer answers
LLM_DAILY_ANSWERS=
# Optional semantic search: cloudflare, Workers AI's bge-m3 (D56). In the Cloudflare dashboard, Workers AI > Use REST
# API gives a Workers AI API token and the account ID. The free plan refuses calls past its daily allocation instead
# of billing. The hunyuan preset (or the older HUNYUAN_EMBEDDING_API_KEY) is Tencent's and isn't used (D55).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional for Cloudflare's free plan; the hunyuan preset requires it, with LLM_USAGE_FILE.
EMBEDDING_TOKEN_BUDGET=
# Each signed-up company's own share of the model above, on top of the shared limits, so one company can't use them up.
# Counted per company next to LLM_USAGE_FILE (llm-usage.<org>.json). A company past its share gets the built-in writer;
# one that picks its own model on the Connectors page isn't counted. Your own company (AUTH0_ORG_ID) has no share.
LLM_COMPANY_DAILY_ANSWERS=
LLM_COMPANY_TOKEN_BUDGET=
EMBEDDING_COMPANY_TOKEN_BUDGET=

# ---- Customer Slack bot onboarding ----
# Customer API. HTTPS origins; register API_ORIGIN/v1/admin/slack-installation/callback in the Slack app.
API_ORIGIN=
WEB_ORIGIN=
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional separate shared installation control plane. Set both on API and gateway, or use Supabase above.
SLACK_REGISTRY_URL=
SLACK_REGISTRY_SECRET_KEY=
# Gateway only. One Slack app signing secret and one request URL set serve all installed workspaces.
SLACK_SIGNING_SECRET=
# Customer API only. Runtime snapshot is published from these trusted settings on install/admin refresh.
SLACK_SERVICE_TOKEN=
SLACK_USERS_JSON=[]
SLACK_CHANNEL_PROJECTS_JSON={}
JIRA_DEFAULT_PROJECT=
JIRA_BASE_URL=
# Explicit channel/project, complete Jira audience allowedSlackIds, and disclosureFields summary/permalink.
SLACK_JIRA_DESTINATIONS_JSON=[]
SLACK_COMPLETION_POLICY_JSON=[]
# Gateway/CLI. At least 32 random characters for workspace-selected maintenance HTTP hooks.
SLACK_WORKER_TOKEN=
# Slack token rotation must be disabled. Never put a bot token in this file.

# Set to "off" to stop the chat from preparing and creating Jira tickets (default: on)
AGENT_ACTIONS=
