# Copy to .env.local at the repository root and fill in the blanks.
# Both processes read .env.local: the web host (pnpm --dir apps/web dev) and the API (pnpm dev:sso).
# Keep comments on their own lines and values unquoted: Next.js and Node's --env-file both parse this file.

# ---- Shared by the web host and the API (values must match) ----
# Identifier of the Auth0 API (Applications > APIs), e.g. https://api.internal-brain
AUTH0_AUDIENCE=
# Company A's Auth0 organization ID (starts with org_), not its display name
AUTH0_ORG_ID=

# ---- Web host (Next.js) ----
APP_BASE_URL=http://127.0.0.1:3001
AUTH0_DOMAIN=dev-3es7focax4cjcswg.us.auth0.com
AUTH0_CLIENT_ID=msyBcV9l7aWnFYDW2NqlF2BvjeeUHwlD
AUTH0_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32
AUTH0_SECRET=
BRAIN_API_URL=http://127.0.0.1:3000
# Optional public demo with fictional data: the demo API's origin, e.g. http://127.0.0.1:3002 next to
# PORT=3002 pnpm dev. Leave it empty to offer SSO only.
DEMO_API_URL=

# ---- API server (pnpm dev:sso) ----
# https://AUTH0_DOMAIN/ including the trailing slash
AUTH0_ISSUER=https://dev-3es7focax4cjcswg.us.auth0.com/
# Supabase project origin and server-only secret key (user directory, audit and state)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Ed25519 private key path, relative to the repository root. Generate locally:
# openssl genpkey -algorithm ed25519 -out audit-signing-key.pem
AUDIT_SIGNING_KEY_FILE=
