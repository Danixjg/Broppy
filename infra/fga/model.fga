model
  schema 1.1

type user

type group
  relations
    define member: [user]

type document
  relations
    define direct_reader: [user]
    define group_reader: [group#member]
    define native_reader: direct_reader or group_reader

# The local adapter also intersects native_reader with tier policy.
# The production gateway must batch-check document IDs here, then re-check
# the selected items against their source before assembling context.
