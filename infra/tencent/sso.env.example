# Settings for the SSO API (compose profile "sso"). Copy to sso.env on the server and fill it in; it is gitignored.
# AUTH0_AUDIENCE and AUTH0_ORG_ID must match the Vercel site's values.
# https://AUTH0_DOMAIN/ including the trailing slash
AUTH0_ISSUER=https://dev-3es7focax4cjcswg.us.auth0.com/
AUTH0_AUDIENCE=
AUTH0_ORG_ID=
# Supabase project origin and server-only secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: Tencent's model for answers through TokenHub, only within its free tokens (1M per language model, 90 days).
# Keep post-paid billing off in TokenHub; these budgets are a second stop.
# Every machine using the same Tencent Cloud account shares them: these budgets plus the laptops' must stay below
# 800000 each. 700000 here leaves 100000 for local runs.
# LLM_PROVIDER=tokenhub
# LLM_API_KEY=
# LLM_MODEL=hy3-preview
# LLM_TOKEN_BUDGET=700000
# Semantic search uses Hunyuan's China-site embeddings, unconfirmed on TokenHub:
# HUNYUAN_EMBEDDING_API_KEY=
# EMBEDDING_TOKEN_BUDGET=700000
