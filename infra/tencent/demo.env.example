# Optional model for the public demo. Copy to demo.env next to compose.yml; compose reads it when it exists, and it
# is gitignored. Groq's free plan has no card on file, so it can never bill.
LLM_PROVIDER=groq
LLM_API_KEY=
# Groq retired llama-3.3-70b-versatile; check the console's model list. gpt-oss-120b reasons before it answers, so it
# needs room for that.
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4000
# Model answers per UTC day, shared by every visitor. After that, the built-in writer answers until midnight UTC.
LLM_DAILY_ANSWERS=100
