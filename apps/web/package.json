{
  "name": "@brain/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:workspace && node scripts/next.mjs dev --hostname 127.0.0.1 --port 3001",
    "build:workspace": "vite build && node scripts/publish-workspace.mjs",
    "build": "pnpm build:workspace && node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4",
    "@next/env": "16.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
